# Optional automation credential; the browser dashboard uses admin login instead.
CONTENT_API_KEY=
CONTENT_API_URL=http://127.0.0.1:8000
# Optional credentials for manual non-browser API clients and legacy Streamlit.
CONTENT_REVIEW_API_KEY=
CONTENT_PUBLISH_API_KEY=

DATABASE_PATH=data/trends.db
CONTENT_PLANS_DIR=data/plans
ANALYTICS_DATABASE_PATH=data/trends.db

# Create the sole admin locally with: python scripts/setup_admin.py
# Never put a plaintext admin password in this file.
ADMIN_CREDENTIALS_FILE=credentials/admin.json
ADMIN_SESSION_HOURS=12
# Enable behind HTTPS; leave false for localhost/SSH-forwarded HTTP.
ADMIN_COOKIE_SECURE=false

YOUTUBE_API_KEY=
YOUTUBE_REGION=US
YOUTUBE_CLIENT_SECRETS=credentials/youtube_client_secret.json
YOUTUBE_TOKEN_FILE=credentials/youtube_token.json
YOUTUBE_PRIVACY_STATUS=private
ANALYTICS_LOOKBACK_DAYS=30

FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v26.0

OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
CONTENT_LANGUAGE=English
IMAGE_MODEL_ID=stable-diffusion-v1-5/stable-diffusion-v1-5
IMAGE_STEPS=20
TTS_VOICE=en-us
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30

# Generation only. Scheduling never approves or publishes content.
SCHEDULER_ENABLED=false
SCHEDULER_TIMEZONE=America/New_York
SCHEDULER_HOUR=9
SCHEDULER_MINUTE=0
SCHEDULER_CATEGORY=science
SCHEDULER_REGION=US
SCHEDULER_VIDEO_LIMIT=5
SCHEDULER_IMAGE_MODE=text
