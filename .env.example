# Optional automation credential; the browser dashboard uses admin login instead.
CONTENT_API_KEY=
CONTENT_API_URL=http://127.0.0.1:8000
# Optional credentials for manual non-browser API clients and legacy Streamlit.
CONTENT_REVIEW_API_KEY=
CONTENT_PUBLISH_API_KEY=

# Optional cloud credentials. OpenAI scripts need explicit cost confirmation.
# Gemini video uses its own key; direct Kling is retired (Runway-hosted models use Runway).
OPENAI_API_KEY=
# Claude screenplay generation (Local Video Studio); keep the value private.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

DATABASE_PATH=data/trends.db

# Automation foundation only; scheduling/production/Governor wiring is future work.
# All execution stays disabled; existing manual review/publishing is unchanged.
AUTOMATION_ENABLED=false
AUTOMATION_LANES_FILE=config/lanes.yaml
# Blank uses the timezone validated in lanes.yaml.
AUTOMATION_TIMEZONE=
AUTOMATION_PLAN_HOUR=0
AUTOMATION_PLAN_MINUTE=5
AUTOMATION_TREND_INTERVAL_HOURS=3
AUTOMATION_GOVERNOR_ENABLED=false
AUTOMATION_GOVERNOR_DRY_RUN=true
AUTOMATION_KILL_SWITCH_FILE=data/automation/KILL
AUTOMATION_DAILY_BUDGET_USD=0
AUTOMATION_ALERT_WEBHOOK_URL=

# Clip Studio: true uses CPU test patterns; false enables explicitly authorized real work.
CLIP_STUDIO_MOCK=false
CLIP_STUDIO_DATA_DIR=data/clip_studio
CLIP_STUDIO_UPLOAD_MB=256
# Native LTX/Wan reuse the installed local cinematic runtime. ComfyUI is optional.
COMFYUI_BASE_URL=http://127.0.0.1:8188
CLIP_STUDIO_ANALYSIS_PYTHON=data/clip_studio_runtime/venv/bin/python
CLIP_STUDIO_WHISPER_DIR=data/clip_studio_runtime/whisper
CLIP_STUDIO_WORKFLOWS_DIR=workflows/clip_studio
CONTENT_PLANS_DIR=data/plans
ANALYTICS_DATABASE_PATH=data/trends.db

# Create the sole admin locally with: python scripts/setup_admin.py
# Never put a plaintext admin password in this file.
ADMIN_CREDENTIALS_FILE=credentials/admin.json
ADMIN_SESSION_HOURS=12
# Enable behind HTTPS; leave false for localhost/SSH-forwarded HTTP.
ADMIN_COOKIE_SECURE=false

YOUTUBE_API_KEY=
YOUTUBE_REGION=US
YOUTUBE_CLIENT_SECRETS=credentials/youtube_client_secret.json
YOUTUBE_TOKEN_FILE=credentials/youtube_token.json
YOUTUBE_PRIVACY_STATUS=private
ANALYTICS_LOOKBACK_DAYS=30

FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
# Optional local token provisioning; never use the App Secret as the Page token.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
META_GRAPH_API_VERSION=v26.0

OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
CONTENT_LANGUAGE=English
IMAGE_MODEL_ID=stable-diffusion-v1-5/stable-diffusion-v1-5
IMAGE_STEPS=20
TTS_VOICE=en-us
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30

# Generation only. Scheduling never approves or publishes content.
SCHEDULER_ENABLED=false
SCHEDULER_TIMEZONE=America/New_York
SCHEDULER_HOUR=9
SCHEDULER_MINUTE=0
SCHEDULER_CATEGORY=science
SCHEDULER_REGION=US
SCHEDULER_VIDEO_LIMIT=5
SCHEDULER_IMAGE_MODE=text

# Local cloud-video assets and character references; do not commit
CLOUD_VIDEOS_DIR=data/videos/cloud
CHARACTER_REFERENCES_DIR=data/character_references

# Runway Dev API (optional paid video provider; explicit cost confirmation required)
RUNWAYML_API_SECRET=
# Optional isolated local cinematic runtime (no cloud video API key)
LOCAL_CINEMATIC_ROOT=data/local_cinematic
LOCAL_CINEMATIC_GPU_MEMORY_FRACTION=0.5
LOCAL_CINEMATIC_MIN_AVAILABLE_GB=16
LOCAL_CINEMATIC_STAGE_TIMEOUT_SECONDS=1800
# Leave empty/unset to use LOCAL_CINEMATIC_ROOT/venv/bin/python
# LOCAL_CINEMATIC_PYTHON=
DRIVING_REFERENCES_DIR=data/driving_references

# Production completion tools (all credentials stay local)
PEXELS_API_KEY=
PRODUCTION_TOOLS_DIR=data/production_tools
SPEECH_RUNTIME_ROOT=data/speech_runtime
SPEECH_WHISPER_MODEL=base
STILL_IMAGE_ROOT=data/still_image_runtime
# Enable only when the application worker is running. No publishing work is queued.
DURABLE_WORKERS=false
LOG_FORMAT_JSON=false
